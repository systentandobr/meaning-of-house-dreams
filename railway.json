{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "environments": {
    "production": { "variables": { "VITE_API_URL": "/gateway", "API_URL": "https://casa-api-production-4d11.up.railway.app" } },
    "staging": { "variables": { "VITE_API_URL": "/gateway", "API_URL": "https://casa-api-production-4d11.up.railway.app" } }
  }
}
