{
  admin off
  persist_config off
  auto_https off
  servers {
    trusted_proxies static private_ranges 100.0.0.0/8
  }
}

:{$PORT:8080} {
  encode gzip

  # NOTE: `handle` blocks are mutually exclusive and are matched before the
  # fallback block below runs `try_files`. Keeping `try_files` inside the
  # fallback `handle` is required — at site level it rewrites /gateway/* to
  # /index.html before the proxy route is evaluated (breaks POST with 405).
  handle /health {
    respond "ok" 200
  }

  # Browser requests use /gateway/api/...; Caddy removes /gateway and proxies
  # to the Go API. The services live in different Railway projects, so the
  # upstream is the public API domain (private *.railway.internal DNS does not
  # resolve across projects).
  handle_path /gateway/* {
    reverse_proxy {$API_URL:https://casa-api-production-4d11.up.railway.app}
  }

  handle {
    root * /app/dist
    try_files {path} /index.html
    file_server
  }
}
